{
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    "module": "nodenext",
    "target": "esnext",
    // For nodejs:
    "lib": [
      "DOM",
      "ESNext"
    ],
    "types": ["chrome"],
    "moduleResolution": "nodenext",

    // Other Outputs
    "sourceMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUnusedParameters": true,

    // Recommended Options
    "strict": true,
    "skipLibCheck": true,
  },

  "include": ["src/**/*"],
}
