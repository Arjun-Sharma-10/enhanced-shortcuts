{
    "manifest_version": 3,
    "name": "Extra Shortcuts",
    "version": "1.0",
    "description": "Shortcuts for things I wanted to have shortcuts",
    "icons": {
        "16": "icons/16px.png",
        "32": "icons/32px.png",
        "48": "icons/48px.png",
        "128": "icons/128px.png"
    },

    "background": {
        "service_worker": "background.js",
        "type": "module"
    },

    "action": {
        "default_popup": "popup/popup.html"
    },

    "permissions": [
        "commands",
        "tabs",  
        "clipboardWrite"
    ],
    
    "commands": {
        "copy-url": {
            "suggested_key": {
                "default": "Alt+C",
                "mac": "Option+C"
            },
        "description": "Copy the URL of the active tab"
        }
    }
}